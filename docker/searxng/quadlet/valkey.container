[Unit]
Description=Valkey (Redis-compatible) cache for SearXNG

[Container]
ContainerName=searxng-valkey
Exec=valkey-server --save 30 1 --loglevel warning
HealthCmd=["valkey-cli","ping"]
HealthInterval=10s
HealthRetries=5
HealthTimeout=3s
Image=docker.io/valkey/valkey:8-alpine
Network=searxng.network
NetworkAlias=valkey
Volume=valkey-data:/data

[Service]
Restart=always

[Install]
WantedBy=default.target
